{
  "name": "cloud-hermes",
  "version": "0.0.0",
  "private": true,
  "description": "A conversational orchestration layer for Google Cloud.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc -b && npm run typecheck -w @cloud-hermes/web",
    "test": "vitest run",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @cloud-hermes/server",
    "dev:web": "npm run dev -w @cloud-hermes/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
